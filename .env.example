JWT_SECRET=change-me-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
CORS_ORIGINS=            # only needed if frontend is on a different origin
TURSO_DATABASE_URL=      # required on Vercel; empty locally -> data/events.db
TURSO_AUTH_TOKEN=
MODEL_MODE=mock          # mock | http
MODEL_URL=               # e.g. https://your-model.vercel.app/api/predict
MODEL_API_KEY=
